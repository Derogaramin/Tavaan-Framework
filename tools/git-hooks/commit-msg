#!/usr/bin/env bash
# تَوان | Tavaan — hook پیام کامیت (DOC-135 §3.4)
# قرارداد پیام: فارسی ساختاریافته —
#   خط موضوع (≤۱۰۰ نویسه) + بدنه با بخش‌های «افزوده شد / تغییر یافت / رفع شد /
#   مستندات / یادداشت / نتایج» (الگوی CHANGELOG.md)
# این hook «دروازهٔ نرم» است: خطای سخت فقط برای پیام خالی؛ بقیه هشدار.
set -u

MSG_FILE="${1:-}"
[ -f "$MSG_FILE" ] || exit 0

# خطوط بدون نظر (merge/fixup) و بدون صلح
BODY="$(grep -v '^#' "$MSG_FILE" | sed '/^$/d')"
SUBJECT="$(printf '%s\n' "$BODY" | head -1)"

# ۱) پیام خالی → رد سخت
if [ -z "$SUBJECT" ]; then
  printf '%s\n' "❌ commit-msg: پیام کامیت خالی است." >&2
  exit 1
fi

# ۲) کامیت‌های ادغام/اصلاح خودکار git — معاف از قرارداد
case "$SUBJECT" in
  Merge\ *|Revert\ *|fixup!\ *|squash!\ *) exit 0 ;;
esac

# ۳) طول خط موضوع — هشدار
LEN="$(printf '%s' "$SUBJECT" | wc -m)"
if [ "$LEN" -gt 100 ]; then
  printf '%s\n' "⚠️  commit-msg: خط موضوع $LEN نویسه است (توصیه: ≤۱۰۰)." >&2
fi

# ۴) بخش‌های ساختاریافته — هشدار (نه رد)
if ! printf '%s\n' "$BODY" | grep -qE '^(افزوده شد|تغییر یافت|رفع شد|مستندات|یادداشت|نتایج|اصلاح شد)(:| —|$|\s)'; then
  cat >&2 <<'EOF'
⚠️  commit-msg: بدنه فاقد بخش‌های ساختاریافتهٔ قرارداد تَوان است.
    الگو (DOC-135 §3.4):
      <موضوع: خلاصهٔ تغییر>

      افزوده شد:
      - …
      تغییر یافت:
      - …
      رفع شد:
      - …
EOF
fi

exit 0
