{
  "id": "tavaan.kit.forum",
  "title_fa": "کیت انجمن",
  "title_en": "Forum Kit",
  "version": "1.0.0",
  "tavaan": "^1.0",
  "architecture": "hmvc",
  "description": "انجمن گفت‌وجوی کامل: تالار تو‌در‌تو، موضوع/پست با رأی و Reputation، پاسخ برگزیده (Q&A)، نقل‌قول، @mention با اعلان، صف moderation با flag، ضداسپم سه‌لایه (throttle/flood/honeypot)، جست‌وجوی فارسی و Realtime/SSE بدون ext (DOC-094).",

  "modules": [
    {"id": "tavaan.core-user", "required": true},
    {"id": "tavaan.content",   "required": true},
    {"id": "tavaan.comment",   "required": true},
    {"id": "tavaan.media",     "required": true},
    {"id": "tavaan.forum",     "required": true}
  ],

  "engines": {
    "required": ["view", "i18n", "search", "cache", "notification", "database", "rbac", "security", "media", "schedule", "realtime"],
    "recommended": ["observability", "queue"]
  },

  "theme": "themes/default",
  "default_preset": "standard",

  "roles": ["member", "moderator", "admin"],
  "demo_data": "seed/demo",

  "requirements": {
    "php": ">=8.2",
    "extensions": ["pdo", "mbstring"],
    "storage_mb": 250,
    "memory_mb": 128
  },

  "install": {
    "steps": ["env", "key:generate", "migrate", "rbac:sync", "seed:demo", "optimize"],
    "wizard": false
  },

  "health_check": "/forums",
  "docs": "kits/forum/README.md"
}
