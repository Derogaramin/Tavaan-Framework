# ─── تَوان | Tavaan — Environment ───────────────────────────────────────────
TVN_APP_NAME=Tavaan
TVN_APP_ENV=local
TVN_APP_DEBUG=true
TVN_APP_KEY=
TVN_APP_URL=http://localhost:8000
TVN_APP_TIMEZONE=Asia/Tehran
TVN_APP_LOCALE=fa

TVN_LOG_CHANNEL=daily
TVN_LOG_LEVEL=debug
TVN_LOG_FORMAT=line

TVN_AUTOLOAD_CACHE=false
TVN_CONFIG_CACHE=false
TVN_CONFIG_SCHEMA=true
TVN_CONTAINER_REFLECTION_CACHE=false
TVN_CONTAINER_COMPILED=false
TVN_CONTAINER_STATS=false
TVN_EVENT_MODE=sync
TVN_EVENT_DEBUG=false
TVN_FAIL_ON_DEPRECATION=false
TVN_COMPAT_WARN=true

# ── M6: سرویس‌ها (Observability/Search/API/Tenancy/FeatureFlag/Realtime) ──
TVN_METRICS=true
TVN_METRICS_PERSIST=false
TVN_METRICS_HTTP=true
TVN_TRACING=false
TVN_TRACE_EXPORTER=log
TVN_TRACE_SAMPLE=1.0
OTEL_EXPORTER_OTLP_ENDPOINT=
TVN_DEBUG_BAR=false
TVN_SEARCH_DRIVER=native
TVN_SEARCH_AUTO_INDEX=true
TVN_API_VERSIONING=url
TVN_API_RATE_MAX=60
TVN_API_RATE_DECAY=60
TVN_TENANCY=false
TVN_TENANCY_STRATEGY=shared
TVN_TENANT_DOMAIN=
TVN_FEATURE_DRIVER=config
TVN_REALTIME_DRIVER=sse
TVN_REALTIME_BROKER=array
TVN_WS_HOST=0.0.0.0
TVN_WS_PORT=8081

# ── M7: دامنه (Workflow/Report/Payment) ────────────────────────────────────
TVN_WORKFLOW_DRIVER=database
TVN_WORKFLOW_MAX_INSTANCES=0
TVN_WORKFLOW_TIMERS=true
TVN_WORKFLOW_TIMER_BATCH=100
TVN_PDF_DRIVER=
TVN_REPORT_MAX_ROWS=100000
TVN_REPORT_STREAM_CHUNK=1000
TVN_PAYMENT_GATEWAY=zarinpal
TVN_PAYMENT_CURRENCY=IRT
TVN_PAYMENT_CALLBACK_URL=
TVN_PAYMENT_NOTIFY_URL=
TVN_PAYMENT_RESULT_URL=
TVN_PAYMENT_IDEMPOTENCY_TTL=86400
TVN_WALLET_ENABLED=true
# 🔒 اعتبارنامهٔ درگاه‌ها (هرگز در کد هاردکد نکنید)
ZARINPAL_MERCHANT=
ZARINPAL_SANDBOX=false
IDPAY_API_KEY=
IDPAY_SANDBOX=false
PAYPING_TOKEN=
SAMAN_MERCHANT=
SAMAN_TERMINAL=
BPM_TERMINAL=
BPM_USERNAME=
BPM_PASSWORD=
PARSIAN_LOGIN=
SADAD_MERCHANT=
SADAD_KEY=
MELLI_MERCHANT=
MELLI_KEY=
STRIPE_SECRET=

# ═══ کلیدهای جامانده — افزوده توسط ممیزی M0–M8 (یافتهٔ M3) ═══
# مقادیر = پیش‌فرض همان config؛ کلیدهای حساس خالی‌اند. همه اختیاری‌اند.

# ── config/modules.php ──
TVN_MODULE_CACHE=false

# ── engines/admin/config/admin.php ──
TVN_ADMIN_GUARD=web
TVN_ADMIN_PER_PAGE=25
TVN_ADMIN_PREFIX=admin

# ── engines/audit/config/audit.php ──
TVN_AUDIT_ENABLED=true
TVN_AUDIT_KEY=
TVN_AUDIT_QUEUE=false

# ── engines/auth/config/auth.php ──
TVN_AUTH_GUARD=web
TVN_JWT_PASSPHRASE=
TVN_JWT_PRIVATE_KEY=
TVN_JWT_PUBLIC_KEY=
TVN_OTP_CHANNEL=log

# ── engines/backup/config/backup.php ──
TVN_BACKUP_DISK=backups
TVN_BACKUP_ENCRYPT=true
TVN_BACKUP_KEEP_DAILY=7
TVN_BACKUP_KEEP_MONTHLY=12
TVN_BACKUP_KEEP_WEEKLY=4
TVN_BACKUP_KEY=
TVN_BACKUP_NOTIFY=true
TVN_BACKUP_VERIFY=true

# ── engines/cache/config/cache.php ──
TVN_CACHE_DRIVER=file
TVN_CACHE_PREFIX=tvn:
TVN_MEMCACHED_HOST=127.0.0.1
TVN_MEMCACHED_PORT=11211
TVN_REDIS_DB=0
TVN_REDIS_HOST=127.0.0.1
TVN_REDIS_PASSWORD=
TVN_REDIS_PORT=6379

# ── engines/compat/config/compat.php ──
TVN_COMPAT_FORCE_FALLBACK=false
TVN_HTTP_DRIVER=auto
TVN_IMAGE_DRIVER=auto
TVN_MATH_DRIVER=auto
TVN_MIME_DRIVER=auto
TVN_UNICODE_DRIVER=auto
TVN_ZIP_DRIVER=auto

# ── engines/config/config/config.php ──
TVN_ENV_FILE=base_path('.env

# ── engines/console/config/console.php ──
