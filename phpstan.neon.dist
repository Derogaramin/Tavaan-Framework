# dev-only — PHPStan level max بدون baseline (AC-CON-05 / DOC-111 §2)
parameters:
    level: max
    paths:
        - core
        - engines
    excludePaths:
        analyseAndScan:
            - */tests/*
            - */benchmarks/*
    treatPhpDocTypesAsCertain: false
    reportUnmatchedIgnoredErrors: false
    bootstrapFiles:
        - core/Support/helpers.php
    scanDirectories:
        - engines
    universalObjectCratesClasses:
        - Tavaan\Engine\Database\ORM\Model
