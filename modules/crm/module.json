{
  "$schema": "https://docs.tavaan.dev/schemas/module.v1.json",
  "id": "tavaan.crm",
  "type": "module",
  "name": "Crm",
  "title_fa": "مدیریت ارتباط با مشتری",
  "title_en": "Customer Relationship Management",
  "version": "0.1.0",
  "description": "CRM کامل: مخاطب با رمزنگاری کدملی، سرنخ با Lead Scoring خودکار، Pipeline فرصت فروش با Workflow و forecast وزنی، فعالیت‌ها (تماس/جلسه/ایمیل/یادداشت/کار)، تیکت پشتیبانی با SLA و escalation خودکار، کمپین ایمیل/پیامک با audience query، همگام‌سازی مشتری فروشگاه (رویدادمحور)، گزارش‌ها (pipeline/win-loss/forecast/کارکرد کارشناس/SLA/منبع سرنخ) و API ورود سرنخ/تیکت (DOC-096).",
  "namespace": "Modules\\Crm\\",
  "autoload": {
    "psr-4": {
      "Modules\\Crm\\": "src/"
    }
  },
  "providers": [
    "Modules\\Crm\\Providers\\CrmServiceProvider"
  ],
  "requires": {
    "tavaan": "^1.0",
    "php": ">=8.2",
    "engines": [
      "view",
      "i18n",
      "search",
      "cache",
      "notification",
      "database",
      "rbac",
      "security",
      "mail",
      "workflow",
      "crypt"
    ],
    "modules": [
      "tavaan.core-user"
    ]
  },
  "tables": [
    "crm_contacts",
    "crm_leads",
    "crm_opportunities",
    "crm_activities",
    "crm_tickets",
    "crm_ticket_replies",
    "crm_campaigns",
    "crm_campaign_recipients"
  ],
  "commands": [
    "Modules\\Crm\\Console\\Commands\\CheckSlaCommand",
    "Modules\\Crm\\Console\\Commands\\SendCampaignsCommand",
    "Modules\\Crm\\Console\\Commands\\RecalculateLeadScoresCommand"
  ],
  "routes": {
    "web": "routes/web.php",
    "admin": "routes/admin.php",
    "api": "routes/api.php"
  },
  "views": {
    "namespace": "crm",
    "path": "views"
  },
  "lang": {
    "path": "lang"
  },
  "migrations": {
    "path": "migrations"
  },
  "seeds": {
    "demo": "seeds/demo.php"
  },
  "events": {
    "published": [
      {
        "name": "crm.lead.created",
        "class": "Modules\\Crm\\Domain\\Events\\LeadWasCreated",
        "version": 1
      },
      {
        "name": "crm.lead.converted",
        "class": "Modules\\Crm\\Domain\\Events\\LeadWasConverted",
        "version": 1
      },
      {
        "name": "crm.opportunity.stage_changed",
        "class": "Modules\\Crm\\Domain\\Events\\OpportunityStageChanged",
        "version": 1
      },
      {
        "name": "crm.opportunity.won",
        "class": "Modules\\Crm\\Domain\\Events\\OpportunityWasWon",
        "version": 1
      },
      {
        "name": "crm.opportunity.lost",
        "class": "Modules\\Crm\\Domain\\Events\\OpportunityWasLost",
        "version": 1
      },
      {
        "name": "crm.ticket.created",
        "class": "Modules\\Crm\\Domain\\Events\\TicketWasCreated",
        "version": 1
      },
      {
        "name": "crm.ticket.assigned",
        "class": "Modules\\Crm\\Domain\\Events\\TicketWasAssigned",
        "version": 1
      },
      {
        "name": "crm.ticket.sla_breached",
        "class": "Modules\\Crm\\Domain\\Events\\TicketSlaBreached",
        "version": 1
      },
      {
        "name": "crm.ticket.resolved",
        "class": "Modules\\Crm\\Domain\\Events\\TicketWasResolved",
        "version": 1
      },
      {
        "name": "crm.campaign.sent",
        "class": "Modules\\Crm\\Domain\\Events\\CampaignWasSent",
        "version": 1
      },
      {
        "name": "crm.contact.synced",
        "class": "Modules\\Crm\\Domain\\Events\\ContactWasSynced",
        "version": 1
      }
    ],
    "consumed": [
      {
        "name": "shop.order.paid",
        "purpose": "همگام‌سازی مشتری فروشگاه → مخاطب (DOC-096 §7)"
      }
    ]
  },
  "permissions": {
    "group": {
      "id": "crm",
      "title_fa": "مدیریت ارتباط با مشتری"
    },
    "items": [
