        "title_fa": "حل/بستن تیکت",
        "title_en": "Resolve/close tickets"
      },
      {
        "key": "crm.campaign.view",
        "title_fa": "مشاهدهٔ کمپین‌ها",
        "title_en": "View campaigns"
      },
      {
        "key": "crm.campaign.manage",
        "title_fa": "ساخت/ویرایش کمپین",
        "title_en": "Manage campaigns"
      },
      {
        "key": "crm.campaign.send",
        "title_fa": "ارسال کمپین",
        "title_en": "Send campaigns"
      },
      {
        "key": "crm.report.view",
        "title_fa": "گزارش‌های CRM",
        "title_en": "View CRM reports"
      }
    ]
  },
  "navigation": [
    {
      "title": "داشبورد CRM",
      "title_fa": "داشبورد CRM",
      "uri": "/admin/crm",
      "icon": "🤝",
