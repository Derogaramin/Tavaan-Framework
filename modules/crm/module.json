      "permission": "crm.opportunity.view",
      "order": 53
    },
    {
      "title": "تیکت‌ها",
      "title_fa": "تیکت‌ها",
      "uri": "/admin/crm/tickets",
      "icon": "🎫",
      "permission": "crm.ticket.create",
      "order": 54
    },
    {
      "title": "کمپین‌ها",
      "title_fa": "کمپین‌ها",
      "uri": "/admin/crm/campaigns",
      "icon": "📣",
      "permission": "crm.campaign.view",
      "order": 55
    },
    {
      "title": "گزارش‌ها",
      "title_fa": "گزارش‌ها",
      "uri": "/admin/crm/reports",
      "icon": "📊",
      "permission": "crm.report.view",
      "order": 56
    }
  ],
  "database": {
    "table_prefix": "crm_",
    "tables": [
      "crm_contacts",
      "crm_leads",
      "crm_opportunities",
      "crm_activities",
      "crm_tickets",
      "crm_ticket_replies",
      "crm_campaigns",
      "crm_campaign_recipients"
    ],
    "seed_on_install": true
  },
  "docs": "modules/crm/README.md",
  "notes": "کیت CRM (kits/crm) این ماژول را با theme/preset/roles/demo نصب می‌کند — DOC-096/TVN-0096. همگام‌سازی shop از راه رویداد shop.order.paid (بدون ارجاع کلاسی — مرز ماژول)."
}
