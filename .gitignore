# Environment
.env
.env.local
.env.*.local
!.env.example
!.env.testing

# Runtime
/storage/**
!/storage/**/
!/storage/**/.gitignore

# Installed third-party plugins (lock + files managed by tvn plugin:*)
/plugins/*
!/plugins/.gitkeep

# Public uploads
/public/uploads/*
!/public/uploads/.gitignore

# Generated by `tvn kit:install` — overlayهای پیکربندی (بازتولیدپذیر؛
# در پروژهٔ اپلیکیشنیِ واقعی می‌توان آن‌ها را commit کرد)
/config/kits.php
/config/blog.php
/config/comment.php

# Generated by `tvn kit:install` — ویوهای کپی‌شدهٔ پوستهٔ کیت
/resources/views/vendor/blog/

# Build
/public/assets/*
!/public/assets/.gitignore
/node_modules/

# Tools & dev
/vendor/
/tools/vendor/
.phpunit.result.cache
.php-cs-fixer.cache
composer.lock

# IDE/OS
/.idea/
/.vscode/
*.swp
.DS_Store
Thumbs.db
